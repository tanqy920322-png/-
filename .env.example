# Local demo defaults. Copy to .env at the repo root. Do not put real keys here.
DATABASE_URL=postgresql+psycopg://fitout:fitout@127.0.0.1:5432/fitout
REDIS_URL=redis://127.0.0.1:6379/0
API_SECRET=dev-only-change-me
STORAGE_DIR=./var/storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo1234
TEST_OTP=123456

# Left empty on purpose. Scene generation and floor-plan recognition stay stubbed.
DASHSCOPE_API_KEY=
VOLCENGINE_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
